# Copy this file to .env.local and fill in the values. Never commit real keys.

# Optional: a public Mapbox token (pk.*) enables live vector tiles.
# Without it, CommunityPulse renders its built-in illustrated map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional live data sources (server-only). Any that are missing are skipped,
# and the feed falls back to the curated sample listings.
EVENTBRITE_API_TOKEN=
# Eventbrite retired public location search, so list the organizers to follow
# (comma-separated IDs from eventbrite.com/o/<name>-<id> URLs).
EVENTBRITE_ORGANIZER_IDS=
TICKETMASTER_API_KEY=
# Needs "Places API (New)" enabled in Google Cloud. The legacy Places API is used as a fallback.
GOOGLE_PLACES_API_KEY=
